PROJECT_ID=your-gcp-project
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
# Cloudflare KV write access for the pipeline. Deliberately not named CF_* /
# CLOUDFLARE_*, which Wrangler would use as its own login when deploying.
KV_ACCOUNT_ID=
KV_NAMESPACE_ID=
KV_API_TOKEN=
# Optional: label and length of the period your BigQuery views cover
PERIOD_LABEL=
PERIOD_DAYS=
